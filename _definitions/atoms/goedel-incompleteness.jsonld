  "preferredTerm": "Gödel incompleteness theorems", "aliases": ["Goedel incompleteness", "incompleteness theorems"], "associatedSymbols": [],
  "plainDefinition": "Results showing limits on what sufficiently expressive, consistent formal systems can prove about themselves.",
  "technicalDefinition": "For suitable effectively axiomatized formal systems containing elementary arithmetic, consistency entails incompleteness; the relevant consistency statement is not provable within the system under the theorem's hypotheses.",
  "scopeAndExclusions": {"scope": ["formal systems meeting the theorem hypotheses"], "exclusions": ["A claim that every truth is unprovable", "A direct theorem about physical reality or theology"]},
  "source": {"sourceName": "Stanford Encyclopedia of Philosophy, Gödel's Incompleteness Theorems", "exactShortQuotation": "any consistent formal system within which a certain amount of arithmetic can be carried out is incomplete", "authoritativeSourceURL": "https://plato.stanford.edu/entries/goedel-incompleteness/", "sourceStatus": "authoritative-secondary", "sourceStatement": "The source states a scoped metamathematical result for qualifying formal systems.", "frameworkInference": "Theophysics registers the result as a definition and does not infer a theological conclusion from it.", "evidenceRef": "tp:evidence:def:goedel/sep"},
