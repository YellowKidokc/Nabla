  "claimID": "tp:ME/L5/C1",
  "name": "The Trilemma Impossibility — J + M + W = 3 requires an external cost-bearer",
  "author": [
    {
      "@type": "Person",
      "name": "David Lowe"
    },
    {
      "@type": "SoftwareApplication",
