{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theophysics.example/schema/lane4_atom.schema.json",
  "title": "Lane 4 Atom",
  "type": "object",
  "additionalProperties": false,
  "required": ["atom_id", "atom_uid", "title", "claim", "domain", "lane", "claim_class", "mode_classification", "assumptions", "definitions", "equations", "bridges", "dependencies", "negative_guards", "kill_conditions", "proof_label", "current_status", "rerun_status", "source_artifacts", "ledger"],
  "properties": {
    "atom_id": {"type": "string", "pattern": "^tp:lane4/[a-z0-9-]+/[a-z0-9-]+$"},
    "atom_uid": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "atom_uuid": {"type": "string", "format": "uuid"},
    "source_claim_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "lane": {"type": "string", "minLength": 1},
    "claim_class": {"type": "string", "minLength": 1},
    "mode_classification": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "definitions": {"type": "array", "items": {"type": "string"}},
    "equations": {"type": "array", "items": {"type": "string"}},
    "bridges": {"type": "array", "items": {}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "negative_guards": {"type": "array", "items": {"type": "string"}},
    "kill_conditions": {"type": "array", "items": {"type": "string"}},
    "proof_label": {"enum": ["LEAN_FORMAL_PROOF", "LEAN_CONDITIONAL_PROOF", "LEAN_GUARDRAIL_SUPPORTED", "PYTHON_RUNTIME_SUPPORTED", "COLAB_REPRODUCIBLE", "SYMBOLIC_SUPPORTED", "HISTORICALLY_SUPPORTED", "ABDUCTIVELY_FAVORED", "BRIDGE_DECLARED", "ISOMORPHIC_EVENT_CANDIDATE", "COUNTERMODEL_FOUND", "NOT_ESTABLISHED", "RERUN_OWED", "QUARANTINE", "NARRATIVE_ANCHOR"]},
    "current_status": {"type": "string", "minLength": 1},
    "rerun_status": {"type": "string", "minLength": 1},
    "source_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "glyphs": {"type": "array", "items": {"type": "string"}},
    "glyph_paths": {"type": "array", "items": {"type": "string"}},
    "classification_bundle": {"type": "object"},
    "ledger": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["event_id", "timestamp", "lane", "event_type"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "event_uuid": {"type": "string", "format": "uuid"},
        "timestamp": {"type": "string", "format": "date-time"},
        "lane": {"type": "string"},
        "event_type": {"type": "string"},
        "result": {"type": "string"},
        "artifact_path": {"type": "string"},
        "old_path": {"type": "string"},
        "new_path": {"type": "string"},
        "meaning": {"type": "string"},
        "limits": {"type": "string"},
        "reviewer": {"type": "string"}
      }
    }
  }
}
