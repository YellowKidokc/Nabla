  "title": "Claim Beacon Invariant Monitor v0.1",
  "type": "object",
  "required": ["monitorID", "subject", "invariant", "reviewTrigger", "status"],
  "properties": {
    "monitorID": {"type": "string"},
    "subject": {"type": "string"},
    "invariant": {"type": "string"},
    "reviewTrigger": {"type": "string"},
