{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faiththruphysics.com/schema/view_definitions.schema.json",
  "title": "Atlas View Definitions",
  "type": "object",
  "required": ["version", "maps"],
  "properties": {
    "version": {"type": "string"},
    "maps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["question", "include_edges", "layout"],
        "additionalProperties": true,
        "properties": {
          "question": {"type": "string"},
          "include_edges": {"type": "array", "items": {"type": "string"}},
          "layout": {"type": "string"},
          "node_color": {"type": "string"},
          "edge_color": {"type": "string"},
          "node_size": {"type": "string"}
        }
      }
    }
  }
}
