{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faiththruphysics.com/schema/canonical_publication.schema.json",
  "title": "Canonical Publication Record",
  "type": "object",
  "required": ["publication_snapshot", "atlas_projection"],
  "additionalProperties": true,
  "properties": {
    "publication_snapshot": {
      "type": "object",
      "required": ["publicationID", "sourcePath", "canonicalDate", "versionID", "sourceHash", "frozenPublicationStats", "canonGate"],
      "additionalProperties": true,
      "properties": {
        "publicationID": {"type": "string"},
        "sourcePath": {"type": "string"},
        "sourceKind": {"type": "string"},
        "canonicalDate": {"type": "string"},
        "versionID": {"type": "string"},
        "sourceHash": {"type": "string"},
        "frozenPublicationStats": {
          "type": "object",
          "required": ["wordCount", "atomCount", "claimCount", "openItemCount", "equationCount"],
          "additionalProperties": true
        },
        "canonGate": {
          "type": "object",
          "required": ["status", "allowedActions", "warning"],
          "properties": {
            "status": {"type": "string", "enum": ["sidecar", "promoted", "rejected", "review_again"]},
            "reviewPrompt": {"type": "string"},
            "allowedActions": {"type": "array", "items": {"type": "string"}},
            "warning": {"type": "string"},
            "acceptedAt": {"type": "string"}
          },
          "additionalProperties": true
        }
      }
    },
    "atlas_projection": {
      "type": "object",
      "required": ["livingAtlasStats"],
      "additionalProperties": true,
      "properties": {
        "livingAtlasStats": {
          "type": "object",
          "required": ["currentStanding", "stillOpenItems", "lastRecalculated"],
          "additionalProperties": true
        },
        "resolution_edges": {"type": "array", "items": {"type": "object"}},
        "method_convergence_receipts": {"type": "array", "items": {"type": "object"}},
        "grades": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
